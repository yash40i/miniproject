# Resume-Insight AI - Environment Variables Template
# Copy this file to .env and fill in with your actual values

# ============================================================================
# LLM CONFIGURATION - Using Groq (RECOMMENDED & FREE!)
# ============================================================================

# Groq API (FREE - Fastest open-source models)
# Get key at: https://console.groq.com/keys
# Sign up → Create API key → Paste below
GROQ_API_KEY=gsk_...

# Alternative Providers (optional):

# OpenAI API (GPT-3.5 / GPT-4) - PAID
# Get key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk_...

# Google Gemini API - PAID
# Get key at: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=AIza...

# ============================================================================
# PIPELINE CONFIGURATION (Optional - defaults provided)
# ============================================================================

# Embedding Model Options:
#   - all-MiniLM-L6-v2 (384 dims, fast) - DEFAULT & RECOMMENDED
#   - all-mpnet-base-v2 (768 dims, balanced)
#   - all-roberta-large-v1 (1024 dims, accurate)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# GPU Configuration
#   - cpu (default)
#   - cuda (if NVIDIA GPU available)
#   - mps (if Apple Silicon)
DEVICE=cpu

# LLM Model Configuration (Groq models - all FREE)
#   - mixtral-8x7b-32768 (fastest, RECOMMENDED)
#   - llama2-70b-4096 (more accurate, slower)
#   - gemma-7b-it (compact and fast)
LLM_MODEL=mixtral-8x7b-32768
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable LLM-based feedback generation
ENABLE_FEEDBACK_GENERATION=true

# Enable learning path generation
ENABLE_LEARNING_PATH_GENERATION=true

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
