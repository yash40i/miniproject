# API Configuration
# In development, this points to the local backend
# In production, update this to your deployed API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/
# Instructions: https://support.google.com/cloud/answer/6158849
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# For production deployments, set to your actual API endpoint:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
